# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and will NOT be committed to the repository.

# HuggingFace token — required for gated models (e.g. formospeech Hakka v3)
# Get yours at https://huggingface.co/settings/tokens
HUGGING_FACE_HUB_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Set to true to deploy Ollama LLM for Hakka → Mandarin translation.
# When true, start with: docker compose --profile llm up -d
# When false (default), start normally: docker compose up -d
ENABLE_LLM=false

# Ollama model for translation (requires ENABLE_LLM=true)
# gemma4:31b  — 31B Dense, 20GB Q4_K_M — best quality for 2× RTX 2080 Ti (22GB total)
# gemma4:26b  — 26B MoE,  18GB Q4_K_M — faster inference, slightly lower quality
OLLAMA_MODEL=gemma4:31b

# Optional Ollama tuning
# OLLAMA_BATCH_SIZE=5
# OLLAMA_TIMEOUT=300

# Private HuggingFace model IDs for language-specific ASR models.
# Leave empty to disable the corresponding language option in the UI.
HAKKA_V2_MODEL=
HAKKA_V3_MODEL=
TAIGI_MODEL=
