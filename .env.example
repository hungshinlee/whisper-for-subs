# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and will NOT be committed to the repository.

# HuggingFace token — required for gated models (e.g. formospeech Hakka v3)
# Get yours at https://huggingface.co/settings/tokens
HUGGING_FACE_HUB_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Set to true to deploy vLLM for Hakka → Mandarin translation.
# When true, start with: docker compose --profile llm up -d
# When false (default), start normally: docker compose up -d
ENABLE_LLM=false

# vLLM model to use for translation (requires ENABLE_LLM=true).
# Must be a full HuggingFace model ID — this is passed directly to vLLM's --model flag.
# Recommended: google/gemma-4-26B-A4B-it (26B MoE, only 4B active params, fits two RTX 2080 Ti)
# The 31B Dense model requires ~62GB VRAM and will NOT fit on 2× RTX 2080 Ti.
VLLM_MODEL=google/gemma-4-26B-A4B-it

# Optional vLLM tuning (leave at defaults unless you have a reason to change)
# VLLM_TENSOR_PARALLEL_SIZE=2   # Number of GPUs to shard the model across
# VLLM_GPU_MEMORY_UTILIZATION=0.90
# VLLM_MAX_MODEL_LEN=32768
# VLLM_BATCH_SIZE=5
# VLLM_TIMEOUT=300

# Private HuggingFace model IDs for language-specific ASR models.
# Leave empty to disable the corresponding language option in the UI.
HAKKA_V2_MODEL=
HAKKA_V3_MODEL=
TAIGI_MODEL=
